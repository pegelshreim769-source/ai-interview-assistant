{
  "name": "ai-interview-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test app/lib/resume-studio/__tests__/*.test.ts app/lib/beta-access/__tests__/*.test.ts",
    "invite:create": "node --conditions=react-server --import tsx scripts/invitations.ts create",
    "invite:list": "node --conditions=react-server --import tsx scripts/invitations.ts list",
    "invite:disable": "node --conditions=react-server --import tsx scripts/invitations.ts disable",
    "invite:revoke": "node --conditions=react-server --import tsx scripts/invitations.ts revoke",
    "eval:routes": "node scripts/eval-routes.mjs"
  },
  "dependencies": {
    "@next/env": "^15.5.21",
    "@phosphor-icons/react": "^2.1.10",
    "docx": "^9.7.1",
    "html2pdf.js": "^0.14.0",
    "mammoth": "^1.12.0",
    "next": "15.5.21",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "^5.8.2",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.21",
    "tsx": "^4.23.1",
    "typescript": "5.5.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "brace-expansion": "1.1.17",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
